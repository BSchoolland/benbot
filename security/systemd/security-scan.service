[Unit]
Description=BenBot hourly vulnerability scan of V2V servers (no model; wakes security-triage on new CVSS>=9 or KEV findings)

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/benbot
ExecStart=%h/.nvm/versions/node/v24.13.0/bin/node security/scan.mjs
Environment=PATH=%h/.nvm/versions/node/v24.13.0/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=1500
