#!/usr/bin/env python3
"""Post to a Discord channel/thread/DM as BenBot.

Usage: discord-send <channel_or_thread_id> <message...>
       echo "long message" | discord-send <channel_or_thread_id> -
Splits into <=1900-char chunks on line boundaries. Prints the message id(s)."""
import json, sys, time, urllib.error, urllib.request
from pathlib import Path

ENV = Path(__file__).resolve().parent.parent / ".env"
API = "https://discord.com/api/v10"
MAX = 1900

def token():
    for line in ENV.read_text().splitlines():
        if line.startswith("DISCORD_TOKEN="):
            return line.split("=", 1)[1].strip().strip('"')
    sys.exit(f"DISCORD_TOKEN not found in {ENV}")

def chunks(text):
    out, cur = [], ""
    for line in text.split("\n"):
        while len(line) > MAX:
            if cur: out.append(cur); cur = ""
            out.append(line[:MAX]); line = line[MAX:]
        joined = f"{cur}\n{line}" if cur else line
        if len(joined) > MAX: out.append(cur); cur = line
        else: cur = joined
    if cur.strip(): out.append(cur)
    return out or [""]

def post(channel_id, content):
    req = urllib.request.Request(f"{API}/channels/{channel_id}/messages",
        data=json.dumps({"content": content}).encode(),
        headers={"Authorization": f"Bot {token()}", "Content-Type": "application/json", "User-Agent": "BenBot (discord-send)"})
    for attempt in range(5):
        try:
            with urllib.request.urlopen(req) as r:
                return json.load(r)["id"]
        except urllib.error.HTTPError as e:
            if e.code == 429:
                time.sleep(float(json.load(e).get("retry_after", 1))); continue
            sys.exit(f"discord-send: HTTP {e.code}: {e.read().decode()[:300]}")
    sys.exit("discord-send: rate limited 5 times, giving up")

def main():
    if len(sys.argv) < 3: sys.exit(__doc__)
    cid = sys.argv[1]
    text = sys.stdin.read() if sys.argv[2] == "-" else " ".join(sys.argv[2:])
    if not text.strip(): sys.exit("discord-send: empty message")
    for c in chunks(text): print(post(cid, c))

if __name__ == "__main__": main()
