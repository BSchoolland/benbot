#!/usr/bin/env python3
"""Post to a Discord channel/thread/DM as BenBot.

Usage: discord-send <channel_or_thread_id> <message...>
       echo "long message" | discord-send <channel_or_thread_id> -
       discord-send <channel_or_thread_id> --file <path> [<path>...] [-- <message...>]
Splits into <=1900-char chunks on line boundaries. Prints the message id(s).

In a voice-bound thread (the bot keeps state/voice/<thread_id>/ while it is on the call) the message is also
spoken: leading [voice:]/[style:]/[fx:]/[pipe:] tags are stripped from the posted text and applied to the audio
(see voice_tts.py). Messages starting with 🎙 are posted silently."""
import json, mimetypes, sys, time, urllib.error, urllib.request, uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import voice_tts  # noqa: E402

ENV = Path(__file__).resolve().parent.parent / ".env"
API = "https://discord.com/api/v10"
MAX = 1900

def token():
    for line in ENV.read_text().splitlines():
        if line.startswith("DISCORD_TOKEN="):
            return line.split("=", 1)[1].strip().strip('"')
    sys.exit(f"DISCORD_TOKEN not found in {ENV}")

def chunks(text):
    out, cur = [], ""
    for line in text.split("\n"):
        while len(line) > MAX:
            if cur: out.append(cur); cur = ""
            out.append(line[:MAX]); line = line[MAX:]
        joined = f"{cur}\n{line}" if cur else line
        if len(joined) > MAX: out.append(cur); cur = line
        else: cur = joined
    if cur.strip(): out.append(cur)
    return out or [""]

def post(channel_id, content, files=()):
    if files:
        boundary = uuid.uuid4().hex
        body = b""
        body += f"--{boundary}\r\nContent-Disposition: form-data; name=\"payload_json\"\r\nContent-Type: application/json\r\n\r\n".encode()
        body += json.dumps({"content": content, "attachments": [{"id": i, "filename": Path(f).name} for i, f in enumerate(files)]}).encode() + b"\r\n"
        for i, f in enumerate(files):
            mime = mimetypes.guess_type(f)[0] or "application/octet-stream"
            body += f"--{boundary}\r\nContent-Disposition: form-data; name=\"files[{i}]\"; filename=\"{Path(f).name}\"\r\nContent-Type: {mime}\r\n\r\n".encode()
            body += Path(f).read_bytes() + b"\r\n"
        body += f"--{boundary}--\r\n".encode()
        req = urllib.request.Request(f"{API}/channels/{channel_id}/messages", data=body,
            headers={"Authorization": f"Bot {token()}", "Content-Type": f"multipart/form-data; boundary={boundary}", "User-Agent": "BenBot (discord-send)"})
    else:
        req = urllib.request.Request(f"{API}/channels/{channel_id}/messages",
            data=json.dumps({"content": content}).encode(),
            headers={"Authorization": f"Bot {token()}", "Content-Type": "application/json", "User-Agent": "BenBot (discord-send)"})
    for attempt in range(5):
        try:
            with urllib.request.urlopen(req) as r:
                return json.load(r)["id"]
        except urllib.error.HTTPError as e:
            if e.code == 429:
                time.sleep(float(json.load(e).get("retry_after", 1))); continue
            sys.exit(f"discord-send: HTTP {e.code}: {e.read().decode()[:300]}")
    sys.exit("discord-send: rate limited 5 times, giving up")

def main():
    if len(sys.argv) < 3: sys.exit(__doc__)
    cid = sys.argv[1]
    if sys.argv[2] == "--file":
        rest = sys.argv[3:]
        files = rest[: rest.index("--")] if "--" in rest else rest
        text = " ".join(rest[rest.index("--") + 1 :]) if "--" in rest else ""
        if not files: sys.exit("discord-send: --file needs at least one path")
        print(post(cid, text, files)); return
    raw = text = sys.stdin.read() if sys.argv[2] == "-" else " ".join(sys.argv[2:])
    if not text.strip(): sys.exit("discord-send: empty message")
    spoken = voice_tts.is_voice_thread(cid) and not text.lstrip().startswith("🎙")
    if spoken: text, _ = voice_tts.parse_tags(text)
    for c in chunks(text): print(post(cid, c))
    if spoken:
        try: voice_tts.speak(cid, raw)
        except RuntimeError as e: sys.exit(f"posted, but could not speak it: {e}")

if __name__ == "__main__": main()
