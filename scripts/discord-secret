#!/usr/bin/env python3
"""Ask Ben for a secret without it ever entering chat or a transcript.

Usage: discord-secret <channel_or_thread_id> <KEY> [what it's for...]

Posts a message with a 🔐 button. Ben clicks it, a modal opens, and the bot writes KEY=value into
~/.budget/credentials.env, then tells this thread's session the key name only. Prints the message id."""
import json, re, sys, urllib.error, urllib.request
from pathlib import Path

ENV = Path(__file__).resolve().parent.parent / ".env"
API = "https://discord.com/api/v10"

def token():
    for line in ENV.read_text().splitlines():
        if line.startswith("DISCORD_TOKEN="):
            return line.split("=", 1)[1].strip().strip('"')
    sys.exit(f"DISCORD_TOKEN not found in {ENV}")

def main():
    if len(sys.argv) < 3: sys.exit(__doc__)
    cid, key = sys.argv[1], sys.argv[2]
    if not re.fullmatch(r"[A-Z][A-Z0-9_]{0,63}", key): sys.exit(f"discord-secret: KEY must look like BEN_SSN, got {key!r}")
    why = " ".join(sys.argv[3:]).strip()
    content = f"🔐 **{key}**" + (f" — {why}" if why else "") + "\nClick to enter it. It goes straight to the homeserver; nothing is posted here."
    body = {"content": content, "components": [{"type": 1, "components": [
        {"type": 2, "style": 1, "label": f"Enter {key}", "custom_id": f"secret:{key}"}]}]}
    req = urllib.request.Request(f"{API}/channels/{cid}/messages", data=json.dumps(body).encode(),
        headers={"Authorization": f"Bot {token()}", "Content-Type": "application/json", "User-Agent": "BenBot (discord-secret)"})
    try:
        with urllib.request.urlopen(req) as r: print(json.load(r)["id"])
    except urllib.error.HTTPError as e:
        sys.exit(f"discord-secret: HTTP {e.code}: {e.read().decode()[:300]}")

if __name__ == "__main__": main()
