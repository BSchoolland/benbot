#!/usr/bin/env python3
"""Add a reaction. Usage: discord-react <channel_or_thread_id> <message_id> <emoji>"""
import sys, urllib.parse, urllib.request, urllib.error
from pathlib import Path
ENV = Path(__file__).resolve().parent.parent / ".env"
def token():
    for line in ENV.read_text().splitlines():
        if line.startswith("DISCORD_TOKEN="): return line.split("=", 1)[1].strip().strip('"')
    sys.exit(f"DISCORD_TOKEN not found in {ENV}")
if len(sys.argv) != 4: sys.exit(__doc__)
cid, mid, emoji = sys.argv[1:]
req = urllib.request.Request(f"https://discord.com/api/v10/channels/{cid}/messages/{mid}/reactions/{urllib.parse.quote(emoji)}/@me",
    method="PUT", headers={"Authorization": f"Bot {token()}", "User-Agent": "BenBot (discord-react)"})
try:
    urllib.request.urlopen(req); print(f"reacted {emoji}")
except urllib.error.HTTPError as e:
    sys.exit(f"discord-react: HTTP {e.code}: {e.read().decode()[:300]}")
