#!/usr/bin/env node
// Scheduled jobs: jobs/<name>.md, gitignored (frontmatter cron/model/cwd/enabled, prompt as body).
// Each is a recurring input to its own long-lived session (job:<name>).
//   jobs list
//   jobs run <name>        tick it within seconds, via the running bot
//   jobs new <name>        scaffold jobs/<name>.md, then edit it
import fs from 'node:fs';
import path from 'node:path';
import { q, db } from '../core/db.mjs';
import { loadJobs, JOBS_DIR } from '../core/jobfiles.mjs';
const [cmd, name] = process.argv.slice(2);
const run = {
  list() {
    for (const j of loadJobs()) {
      const st = q.jobState.get(j.name);
      const last = st?.last_run_at ? new Date(st.last_run_at).toISOString().slice(0, 16) : 'never';
      console.log(`${j.enabled ? '●' : '○'} ${j.name}  [${j.cron}]  ${j.model}  last ${last}  cwd ${j.cwd ?? '(jobs)'}\n    ${j.prompt.replace(/\s+/g, ' ').slice(0, 140)}`);
    }
  },
  run(n) { if (!n) throw new Error('name?'); q.jobRunNow.run(n); console.log(`${n} will tick within seconds`); },
  new(n) {
    if (!n) throw new Error('name?');
    const f = path.join(JOBS_DIR, `${n}.md`);
    if (fs.existsSync(f)) throw new Error(`${f} exists`);
    fs.mkdirSync(JOBS_DIR, { recursive: true });
    fs.writeFileSync(f, `---\ncron: 0 9 * * *\nmodel: opus\n---\nWhat this job does, addressed to the session that will do it.\n`);
    console.log(f);
  },
};
if (!run[cmd]) { console.error('usage: see header of scripts/jobs'); process.exit(2); }
try { run[cmd](name); } catch (e) { console.error(e.message); process.exit(1); }
// Node 24 segfaults in v8 teardown with the better-sqlite3 handle still open; close it and leave explicitly.
db.close();
process.exit(0);
