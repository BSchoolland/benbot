#!/usr/bin/env python3
"""Print recent messages of a channel/thread/DM, oldest first. Usage: discord-read <id> [--limit N]"""
import json, sys, urllib.request, urllib.error
from datetime import datetime
from pathlib import Path
ENV = Path(__file__).resolve().parent.parent / ".env"
def token():
    for line in ENV.read_text().splitlines():
        if line.startswith("DISCORD_TOKEN="): return line.split("=", 1)[1].strip().strip('"')
    sys.exit(f"DISCORD_TOKEN not found in {ENV}")
args = sys.argv[1:]
if not args: sys.exit(__doc__)
cid = args[0]; limit = int(args[args.index("--limit") + 1]) if "--limit" in args else 30
req = urllib.request.Request(f"https://discord.com/api/v10/channels/{cid}/messages?limit={min(limit,100)}",
    headers={"Authorization": f"Bot {token()}", "User-Agent": "BenBot (discord-read)"})
try:
    msgs = json.load(urllib.request.urlopen(req))
except urllib.error.HTTPError as e:
    sys.exit(f"discord-read: HTTP {e.code}: {e.read().decode()[:300]}")
for m in reversed(msgs):
    ts = datetime.fromisoformat(m["timestamp"]).strftime("%m-%d %H:%M")
    name = m["author"].get("global_name") or m["author"]["username"]
    body = m.get("content", "")
    for a in m.get("attachments", []): body += f"\n    [attachment] {a['url']}"
    print(f"[{ts}] {name} (msg {m['id']}): {body}")
