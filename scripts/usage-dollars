#!/usr/bin/env python3
"""List-price dollar spend inside the current 5-hour and weekly limit windows, next to
the utilization %, and the implied worth of a full window. Spend is summed from every
Claude Code transcript under ~/.claude/projects (deduped by message id). Ben's budgets
are the limits, not dollars; this exists to calibrate what a limit is worth."""
import glob, json, os, subprocess, sys
from datetime import datetime, timedelta, timezone

# $/MTok: input, output, cache write 5m, cache write 1h, cache read (list, 2026-06)
PRICE = {
    "claude-fable-5-1": (10, 50, 12.5, 20, 0.25),
    "claude-fable-5": (10, 50, 12.5, 20, 1.0),
    "claude-opus-5": (5, 25, 6.25, 10, 0.5),
    "claude-opus-4-8": (5, 25, 6.25, 10, 0.5),
    "claude-opus-4-7": (5, 25, 6.25, 10, 0.5),
    "claude-opus-4-6": (5, 25, 6.25, 10, 0.5),
    "claude-sonnet-5": (2, 10, 2.5, 4, 0.2),
    "claude-sonnet-4-6": (3, 15, 3.75, 6, 0.3),
    "claude-haiku-4-5": (1, 5, 1.25, 2, 0.1),
    "claude-haiku-4-5-20251001": (1, 5, 1.25, 2, 0.1),
}
HERE = os.path.dirname(os.path.abspath(__file__))
limits = json.loads(subprocess.check_output([os.path.join(HERE, "usage-limits"), "--json"]))
windows = {
    "5h session": (datetime.fromisoformat(limits["5h session"]["resets_at"]) - timedelta(hours=5), limits["5h session"]["percent"]),
    "weekly all": (datetime.fromisoformat(limits["weekly all"]["resets_at"]) - timedelta(days=7), limits["weekly all"]["percent"]),
}
earliest = min(w[0] for w in windows.values())

seen = {}
for f in glob.glob(os.path.expanduser("~/.claude/projects/**/*.jsonl"), recursive=True):
    if datetime.fromtimestamp(os.path.getmtime(f), timezone.utc) < earliest:
        continue
    for line in open(f, errors="replace"):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") != "assistant":
            continue
        m = e.get("message", {})
        ts = e.get("timestamp")
        if not ts or "usage" not in m or m.get("model", "").startswith("<"):
            continue
        u = m["usage"]
        cc = u.get("cache_creation") or {}
        c5, c1 = cc.get("ephemeral_5m_input_tokens", 0), cc.get("ephemeral_1h_input_tokens", 0)
        if c5 + c1 == 0:
            c5 = u.get("cache_creation_input_tokens", 0)
        rec = (datetime.fromisoformat(ts.replace("Z", "+00:00")), m["model"], u.get("input_tokens", 0),
               u.get("output_tokens", 0), c5, c1, u.get("cache_read_input_tokens", 0))
        mid = m.get("id") or e.get("uuid")
        if mid not in seen or rec[3] >= seen[mid][3]:
            seen[mid] = rec

def cost(rec):
    p = PRICE.get(rec[1])
    if p is None:
        sys.exit(f"no list price for model {rec[1]}; add it to PRICE in {__file__}")
    return (rec[2] * p[0] + rec[3] * p[1] + rec[4] * p[2] + rec[5] * p[3] + rec[6] * p[4]) / 1e6

for name, (start, pct) in windows.items():
    by_model = {}
    for rec in seen.values():
        if rec[0] >= start:
            by_model[rec[1]] = by_model.get(rec[1], 0) + cost(rec)
    total = sum(by_model.values())
    implied = total / pct * 100 if pct else float("nan")
    detail = ", ".join(f"{m.replace('claude-', '')} ${c:.2f}" for m, c in sorted(by_model.items(), key=lambda kv: -kv[1]))
    print(f"{name:12} {pct:3d}% used = ${total:7.2f} list  ->  full window ≈ ${implied:,.0f}   ({detail})")
